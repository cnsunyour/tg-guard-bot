# Telegram Bot 配置
# ⚠️ 从 @BotFather 获取你的 bot token
BOT_TOKEN=<YOUR_BOT_TOKEN_HERE>
# ⚠️ 管理员用户 ID（多个用逗号分隔）
ADMIN_IDS=<YOUR_ADMIN_ID>,<ANOTHER_ADMIN_ID>

# 数据库配置
# ⚠️ 生产环境必须使用强密码！至少 16 字符，包含大小写字母、数字和特殊字符
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_16+_CHARS
DB_NAME=tg_guard

# Redis 配置
# ⚠️ 生产环境必须设置强密码！至少 16 字符
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_16+_CHARS

# 应用配置
LOG_LEVEL=INFO
DEBUG=false

# Sentry 配置（错误监控和日志聚合）
# ⚠️ 可选：如需启用 Sentry 监控，请从 https://sentry.io 获取 DSN
# 留空则不启用 Sentry
SENTRY_DSN=
# Sentry 环境标识（development/staging/production）
SENTRY_ENVIRONMENT=production
# 性能监控采样率（0.0-1.0）
# 1.0 = 100% 采样（开发环境），0.1 = 10% 采样（生产环境推荐）
SENTRY_TRACES_SAMPLE_RATE=1.0

# 反垃圾配置

# CAS (Combot Anti-Spam) 配置（可选）
# 启用后会在入群和消息阶段检查 CAS 全局黑名单
CAS_ENABLED=false
CAS_API_URL=https://api.cas.chat
CAS_CHECK_TIMEOUT=5
CAS_CACHE_TTL=86400
CAS_MAX_RETRIES=2

SPAM_THRESHOLD_RULE=0.8
SPAM_THRESHOLD_ML=0.7
SPAM_THRESHOLD_EMBEDDING=0.75

# 活跃度系统配置
ACTIVITY_ENABLED=true
ACTIVITY_MAX_CONFIDENCE_REDUCTION=0.15
# 活跃度跳过垃圾检测阈值
# >0 = 全局统一阈值（所有群组使用此值）
#  0 = 使用群组配置（默认，每个群组单独设置）
# <0 = 全局禁用（所有群组都不跳过检测）
ACTIVITY_SKIP_SPAM_CHECK_THRESHOLD=0

# OCR 配置（图片垃圾检测）
# ========== 主 OCR 开关 ==========
# ⚠️ 注意事项：
#   - 支持多种 OCR 提供者（优先级：Gemini AI > 百度云 > PaddleOCR > EasyOCR）
#   - 推荐配置 Gemini AI OCR 或百度云 OCR（内存占用 <200MB）
#   - 本地 OCR（PaddleOCR/EasyOCR）需要 1-8GB RAM
ENABLE_OCR=false

# ========== OpenAI OCR 配置 ==========
# 第一优先级：云 API，内存占用 ~100MB
# 注册地址: https://platform.openai.com/api-keys
# 注意：使用 OpenAI Vision API 进行图片文字识别
#
# 模型选择:
#   - gpt-4o-mini（推荐）：快速、便宜，性价比高
#   - gpt-4o：高准确率，速度更快
#   - chatgpt-4o-latest：最新版本
#
# 费用：按使用量计费，详见 https://openai.com/pricing
# Vision API 支持：gpt-4o、gpt-4o-mini、gpt-4-turbo 等
OCR_OPENAI_ENABLED=false
OCR_OPENAI_API_KEY=
OCR_OPENAI_MODEL=gpt-4o-mini
# 自定义 API Base URL（可选，用于代理或兼容接口）
# 例如：https://api.openai.com/v1 或兼容接口
OCR_OPENAI_API_URL=
# 超时时间（秒）
OCR_OPENAI_TIMEOUT=30

# ========== 百度智能云 OCR 配置 ==========
# 第二优先级：云 API，内存占用 ~100MB
# 注册地址: https://cloud.baidu.com/product/ocr
# 免费额度: 通用文字识别 5000次/月，高精度 500次/天
# 超出后按量计费：¥0.003/次
OCR_BAIDU_ENABLED=false
OCR_BAIDU_API_KEY=
OCR_BAIDU_SECRET_KEY=
# 是否使用高精度版（准确率更高，但免费额度更少）
OCR_BAIDU_USE_ACCURATE=false
# 超时时间（秒）
OCR_BAIDU_TIMEOUT=10

# ========== PaddleOCR 配置 ==========
# 第三优先级：本地 OCR，内存占用 ~1-2GB
# CPU 版本（默认）
# 语言支持: ch=中英文, en=英文
OCR_PADDLE_ENABLED=true
OCR_PADDLE_LANG=ch

# ========== EasyOCR 配置 ==========
# 最终回退：本地 OCR，内存占用 ~4-8GB
# CPU 版本（默认）
# 始终作为最终回退选项
OCR_EASY_ENABLED=true

# 模型自动训练配置
# 当新增样本数达到此阈值时，自动触发模型重新训练
# 建议值：
#   - 200: 较频繁训练（约 2 周一次，适合快速迭代）
#   - 500: 平衡选择（约 1 个月一次，推荐）
#   - 1000: 较少训练（约 2 个月一次，适合稳定运行）
# 管理员仍可随时使用 /train 命令手动触发训练
AUTO_TRAIN_THRESHOLD=500

# 自动训练冷却时间（小时）
# 两次自动训练之间的最小间隔时间，防止短时间内频繁训练
# 建议值：
#   - 24: 最少 1 天（适合测试环境）
#   - 168: 最少 7 天（推荐，约 1 周）
#   - 336: 最少 14 天（适合稳定运行）
# 即使达到样本阈值，也会等待冷却时间结束后才训练
AUTO_TRAIN_COOLDOWN_HOURS=168

# 验证配置
VERIFICATION_TIMEOUT=60
MAX_WARNINGS=3

# 模型安全配置（✅ P1-9: 必填字段）
# ⚠️ 必填！用于验证 ML 模型文件完整性，防止恶意模型注入
# 🔐 安全要求：
#   - 必须至少 32 个字符
#   - 使用强随机密钥，不要使用下面的示例值
#   - 生产环境必须保密，不要提交到 Git
# 🛠️ 生成方法：
#   - Linux/macOS: openssl rand -hex 32
#   - Python: python -c "import secrets; print(secrets.token_hex(32))"
MODEL_SIGNATURE_KEY=<请使用上面的命令生成64字符随机密钥>

# AI 垃圾检测配置（OpenAI 兼容 API）
# ⚠️ 可选功能：使用第三方 AI API 进行垃圾检测
# 支持 OpenAI、OpenRouter、DeepSeek、Moonshot 等兼容接口
AI_SPAM_ENABLED=false
# API Key（留空表示未启用）
AI_SPAM_API_KEY=
# API Base URL（OpenAI 兼容接口）
# 示例：
#   - OpenAI: https://api.openai.com/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - DeepSeek: https://api.deepseek.com/v1
#   - Moonshot: https://api.moonshot.cn/v1
AI_SPAM_API_BASE=https://api.openai.com/v1
# 模型名称（根据不同 API 提供商而定）
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# DeepSeek: deepseek-chat
# Moonshot: moonshot-v1-8k, moonshot-v1-32k
# OpenRouter: 支持多种模型
AI_SPAM_MODEL=gpt-4o-mini
# 生成温度（0.0 = 确定性输出，1.0 = 更随机）
AI_SPAM_TEMPERATURE=0.0
# 置信度阈值（0.0-1.0，推荐 0.8）
AI_SPAM_THRESHOLD=0.8
# 超时时间（秒）
AI_SPAM_TIMEOUT=10
# 最大重试次数
AI_SPAM_MAX_RETRIES=2
# 是否自动将 AI 检测到的垃圾样本入库训练
AI_SPAM_AUTO_TRAIN=true
# 是否自动将高置信度负样本（正常消息）入库训练
# 负样本入库策略：只入库 AI 高度确信不是垃圾的消息（低置信度）
# 优点：平衡正负样本，提高模型准确率
# 缺点：增加存储空间和训练时间
AI_SPAM_AUTO_TRAIN_NEGATIVES=false
# 负样本置信度阈值（0.0-1.0）
# 只有当 confidence <= 此值时，才会将正常消息入库作为负样本
# 推荐值：0.2（表示 AI 80% 以上确信不是垃圾）
# 示例：
#   confidence=0.05 → 入库（AI 95% 确信是正常消息）
#   confidence=0.45 → 不入库（AI 只有 55% 确信是正常消息）
AI_SPAM_NEGATIVE_THRESHOLD=0.2
# 文本最大长度（超长文本会被截断）
AI_SPAM_MAX_LENGTH=500
# AI 标注者 ID（用于标记 AI 自动标注的样本）
AI_SPAM_LABELED_BY=-1

# ========== AI 垃圾检测配置（备份服务商） ==========
# 可选：配置第二个 AI 服务商作为备份
# 当主服务商全部重试失败后，自动切换到备份服务商
# 两个服务商都失败后，降级到传统检测结果
#
# 使用场景：
#   - 提高系统可用性（主服务商故障时自动切换）
#   - 分担 API 请求量（主服务商配额耗尽时切换）
#   - 跨区域冗余（不同服务商在不同地区的稳定性）
#
# 是否启用备份服务商
AI_SPAM_BACKUP_ENABLED=false
# 备份 API Key（留空表示未启用）
AI_SPAM_BACKUP_API_KEY=
# 备份 API Base URL（OpenAI 兼容接口）
# 示例：
#   - OpenAI: https://api.openai.com/v1
#   - DeepSeek: https://api.deepseek.com/v1
#   - Moonshot: https://api.moonshot.cn/v1
#   - OpenRouter: https://openrouter.ai/api/v1
AI_SPAM_BACKUP_API_BASE=https://api.openai.com/v1
# 备份模型名称
AI_SPAM_BACKUP_MODEL=gpt-4o-mini
# 备份生成温度
AI_SPAM_BACKUP_TEMPERATURE=0.0
# 备份置信度阈值（0.0-1.0，推荐 0.8）
AI_SPAM_BACKUP_THRESHOLD=0.8
# 备份超时时间（秒）
AI_SPAM_BACKUP_TIMEOUT=10
# 备份最大重试次数
AI_SPAM_BACKUP_MAX_RETRIES=2

# 上下文检测配置
# ⚠️ 可选功能：结合群组对话上下文进行垃圾检测，降低误判率
# 需要启用 AI_SPAM_ENABLED 才能使用上下文检测
CONTEXT_ENABLED=false
# 群组上下文缓存消息数量（最近 N 条消息）
# 推荐值：10（约 1-2 分钟对话量）
CONTEXT_MESSAGE_COUNT=10
# 上下文缓存时间（分钟）
# 推荐值：10（10 分钟后自动清理不活跃群组的上下文）
CONTEXT_TTL_MINUTES=10
# 回复链最大追溯深度（向上追溯多少层 reply_to_message）
# 推荐值：3（避免过深追溯导致性能问题）
CONTEXT_REPLY_DEPTH=3
# 单条消息最大文本长度（用于上下文缓存，超长文本会被截断）
# 推荐值：200（避免缓存过多冗余文本）
CONTEXT_MAX_TEXT_LENGTH=200

# 上下文一致性检测配置（用于降低误判）
# ⚠️ 推荐启用：通过语义分析降低正常对话被误判为垃圾的概率
# 工作原理：
#   - 如果消息与上下文高度相关（如回复问题、参与讨论），降低垃圾判定置信度
#   - 只降低误判，不提高检测（避免误判正常的话题转移）
CONTEXT_CONSISTENCY_ENABLED=true
# 高相似度阈值（0.0-1.0）
# 当消息与上下文相似度 >= 此值时，视为正常对话的一部分
# 推荐值：0.7（70%相似度）
CONTEXT_HIGH_SIMILARITY_THRESHOLD=0.7
# 置信度降低幅度（0.0-1.0）
# 检测到上下文一致时，降低的垃圾置信度
# 推荐值：0.15（降低15%）
CONTEXT_CONFIDENCE_REDUCTION=0.15
# 回复链相似度阈值（0.0-1.0）
# 当回复内容与被回复消息相似度 >= 此值时，视为正常对话
# 推荐值：0.5（50%相似度）
REPLY_SIMILARITY_THRESHOLD=0.5
# 回复链置信度降低幅度（0.0-1.0）
# 推荐值：0.2（降低20%，因为回复关系更明确）
REPLY_CONFIDENCE_REDUCTION=0.2

# ========== 统一 CAPTCHA 验证配置 ==========
# 统一 CAPTCHA WebApp（支持多种验证服务：Turnstile, Friendly, hCaptcha, MTCaptcha）
# ⚠️ 推荐使用：所有 CAPTCHA 服务统一部署到一个 WebApp
# 部署地址（例如：https://captcha.your-domain.pages.dev）
CAPTCHA_WEBAPP_URL=
# 共享签名密钥（用于验证所有 CAPTCHA 服务回调，至少 32 字符）
# 生成方法: openssl rand -hex 32
CAPTCHA_SIGNATURE_KEY=

# Turnstile 验证配置（Cloudflare 无感人机验证）
# ⚠️ 已完全集成到统一 CAPTCHA WebApp，必须配置 CAPTCHA_WEBAPP_URL 和 CAPTCHA_SIGNATURE_KEY
TURNSTILE_ENABLED=false
# Turnstile Site Key（可选）：用于随机验证可用性判断；留空则随机验证不会选中 Turnstile
# TURNSTILE_SECRET_KEY 不在 Bot 端配置：请在 captcha-webapp（Cloudflare Pages/Functions）环境变量中配置
TURNSTILE_SITE_KEY=

# Friendly Captcha 验证配置（隐私友好，支持多 key 轮换）
# ⚠️ 可选功能：使用 Friendly Captcha 进行人机验证
# 注册地址：https://friendlycaptcha.com/
# 支持多 key 轮换：可以配置多个 sitekey/apikey 对，Bot 会自动轮换使用
FRIENDLY_ENABLED=false
# JSON 数组格式，示例：
# FRIENDLY_KEYS='[{"sitekey":"FCMAV...","apikey":"fc-sk-..."},{"sitekey":"FCMAV2...","apikey":"fc-sk2-..."}]'
FRIENDLY_KEYS=

# hCaptcha 验证配置（图片验证）
# ⚠️ 可选功能：使用 hCaptcha 进行人机验证
# 注册地址：https://www.hcaptcha.com/
# 注意：免费版需要用户手动完成图片验证任务
HCAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# MTCaptcha 验证配置（自适应无感验证）
# ⚠️ 可选功能：使用 MTCaptcha 进行人机验证
# 注册地址：https://www.mtcaptcha.com/
MTCAPTCHA_ENABLED=false
MTCAPTCHA_SITE_KEY=
MTCAPTCHA_PRIVATE_KEY=

# ALTCHA 验证配置（开源自托管，proof-of-work）
# ⚠️ 可选功能：使用 ALTCHA 进行人机验证
# 需要单独部署 PHP 后端（可使用 Serv00 免费主机）
# GitHub: https://github.com/altcha-org/altcha
ALTCHA_ENABLED=false
# ALTCHA PHP 后端地址（例如：https://xxx.serv00.net/altcha）
ALTCHA_API_URL=
# HMAC 密钥（与 PHP 后端共享，用于挑战生成和验证，至少 32 字符）
# 生成方法: openssl rand -hex 32
ALTCHA_HMAC_KEY=

# AI 模型路径
ML_MODEL_PATH=data/models/spam_classifier.pkl
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# Telethon 配置（用于获取群组成员列表）
# ⚠️ 可选功能：启用后可使用 /cleanup 命令清理不活跃用户
# 需要从 https://my.telegram.org 获取 API 凭据
TELETHON_ENABLED=false
# Telegram API ID（从 my.telegram.org 获取）
TELETHON_API_ID=
# Telegram API Hash（从 my.telegram.org 获取）
TELETHON_API_HASH=
# Session 文件路径（首次需要运行 scripts/telethon_login.py 生成）
TELETHON_SESSION_PATH=./data/user_bot.session
# 成员列表缓存时间（秒，默认 1 小时）
CLEANUP_CACHE_TTL=3600

# ========== 代理配置（可选）==========
# ⚠️ 如果你的服务器在墙内，需要配置代理才能访问 Telegram API
# 支持的代理类型：socks5（推荐）、socks4、http
# 优先级：socks5_proxy > socks_proxy > all_proxy > https_proxy > http_proxy
#
# ⚠️ Docker 环境特别注意：
# 如果代理运行在宿主机，不要使用 127.0.0.1！应该使用：
#   - Linux: host.docker.internal 或 172.17.0.1（Docker 默认网关）
#   - macOS/Windows: host.docker.internal
#
# 示例（宿主机代理 - Docker 环境）：
# all_proxy=socks5://host.docker.internal:7891
#
# 示例（宿主机代理 - 非 Docker 环境）：
# all_proxy=socks5://127.0.0.1:7891
#
# 示例（远程代理）：
# all_proxy=socks5://proxy.example.com:1080
# all_proxy=socks5://user:pass@proxy.example.com:1080  # 带认证
# all_proxy=http://proxy.example.com:8080
#
# 留空表示不使用代理
#all_proxy=

